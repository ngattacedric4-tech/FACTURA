# Copy to .env.local and fill in real values. Never commit real keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. NEVER prefix with VITE_ (would expose key in client bundle).
# Use behind a Supabase Edge Function, not directly in client code.
GEMINI_API_KEY=your-gemini-key-here
